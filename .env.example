# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your secrets never end up on GitHub.

# --- Supabase (Step 1) ---
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret "service_role" key. Server-only. Never share it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Step 2) ---
# Google Cloud console -> APIs & Services -> Credentials -> your OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gemini OCR (Step 3) ---
# From https://aistudio.google.com/app/apikey — starts with "AQ." (or
# "AIza" for older keys)
GEMINI_API_KEY=

# --- Stripe billing (Step 5) ---
# Stripe dashboard -> Developers -> API keys ("Secret key", sk_test_... in
# test mode)
STRIPE_SECRET_KEY=
# Stripe dashboard -> your product -> the monthly price's ID (price_...)
STRIPE_PRICE_ID=
# Stripe dashboard -> Developers -> Webhooks -> your endpoint -> "Signing
# secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=
