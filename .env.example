# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your secrets never end up on GitHub.

# --- Supabase (Step 1) ---
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret "service_role" key. Server-only. Never share it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Step 2) ---
# Google Cloud console -> APIs & Services -> Credentials -> your OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Added in later steps ---
# GEMINI_API_KEY=            (Step 3: OCR)
# STRIPE_SECRET_KEY=         (Step 5: billing)
# STRIPE_WEBHOOK_SECRET=     (Step 5: billing)
# STRIPE_PRICE_ID=           (Step 5: billing)
